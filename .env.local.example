# Copy to .env.local and fill in real values.

# ── Builder auth ────────────────────────────────────────────────────────────
# Password to access the builder (internal team only).
BUILDER_PASSWORD=your-team-password-here

# ── File uploads (Vercel Blob) ───────────────────────────────────────────────
# Enables screenshot + CSV uploads. Get from Vercel Dashboard > Storage > Blob.
# Without this, file uploads are silently skipped.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Demo factory (Phase 2) ───────────────────────────────────────────────────
# GitHub Personal Access Token with "workflow" scope — triggers demo-factory.yml.
GITHUB_TOKEN_WORKFLOW=ghp_...

# GitHub repo in "owner/repo" format.
GITHUB_REPO=brantwadsworth-ts/tse_embed_demos

# ── GitHub Actions secrets (set in repo Settings → Secrets → Actions) ────────
# These are NOT used by the Next.js app — they live only in GitHub Actions.
# Documented here for reference:
#
#   SNOWFLAKE_ACCOUNT                 THOUGHTSPOT_PARTNER
#   SNOWFLAKE_USER                    SE_DEMO_KP
#   SNOWFLAKE_PRIVATE_KEY             (paste contents of ~/.snowflake/rsa_key.p8)
#   SNOWFLAKE_PRIVATE_KEY_PASSPHRASE  (key passphrase)
#   SNOWFLAKE_WAREHOUSE               SE_DEMO_WH
#   SNOWFLAKE_ROLE                    SE_ROLE
#   TS_HOST                           https://se-thoughtspot-cloud.thoughtspot.cloud
#   TS_ADMIN_USER                     (your ThoughtSpot admin username)
#   TOKEN_SERVICE_URL                 (deployed token-service URL)
#   TOKEN_SERVICE_API_KEY             (admin key from token-service REGISTRY)
