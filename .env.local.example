# Copy to .env.local and fill in real values.

# ThoughtSpot cluster URL — used client-side by the Embed SDK.
# Public intentionally (the SDK needs it in the browser).
TS_HOST=https://your-instance.thoughtspot.cloud
NEXT_PUBLIC_TS_HOST=https://your-instance.thoughtspot.cloud

# --- Token microservice (token-service branch / separate Vercel deploy) ---
# The TS_SECRET_KEY now lives only in the token service; this demo never
# touches it directly.
TOKEN_SERVICE_URL=https://your-token-service.vercel.app
DEMO_API_KEY=demo-api-key-change-me

# --- ThoughtSpot content GUIDs ---
# GUID of the liveboard to embed on the landing page.
NEXT_PUBLIC_LIVEBOARD_ID=your-liveboard-guid-here

# GUID of the worksheet/model backing the "Country Name" column.
TS_COUNTRY_WORKSHEET_ID=your-worksheet-guid-here

# GUID of the worksheet/model Spotter queries against on the AI Analytics page.
NEXT_PUBLIC_SPOTTER_WORKSHEET_ID=your-worksheet-guid-here

# --- Prospect branding (see lib/embedBranding.ts) ---
# Changing these to reuse this app for a different prospect is a pure
# .env edit + rebuild — no code change needed.
NEXT_PUBLIC_BRAND_NAME=your-customer-name-here
NEXT_PUBLIC_SPOTTER_PERSONA_NAME=your-ai-persona-name-here
NEXT_PUBLIC_SPOTTER_CARD_LABEL=your-response-card-label-here

# Optional: URL of a customer-hosted SVG sprite to replace ThoughtSpot's icons.
NEXT_PUBLIC_ICON_SPRITE_URL=your-icon-sprite-svg-url-here
