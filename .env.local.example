# Copy this file to .env.local and fill in real values.

# ThoughtSpot cluster URL, e.g. https://your-company.thoughtspot.cloud
# Used both server-side (token generation) and client-side (SDK init), so
# it's exposed to the browser deliberately -- it is not a secret.
TS_HOST=https://your-instance.thoughtspot.cloud
NEXT_PUBLIC_TS_HOST=https://your-instance.thoughtspot.cloud

# ThoughtSpot trusted-auth secret key (Develop > Customization > Security in
# the ThoughtSpot admin panel). Server-only -- never expose with NEXT_PUBLIC_.
TS_SECRET_KEY=your-secret-key-here

# Org identifier (name or numeric ID) -- required for multi-tenant clusters.
TS_ORG_IDENTIFIER=your-org-id-here

# Bearer token lifetime in seconds, passed to ThoughtSpot as
# validity_time_in_sec (ThoughtSpot's own default is also 300 if unset).
TS_TOKEN_VALIDITY_SEC=300

# GUID of the liveboard to embed on the landing page.
NEXT_PUBLIC_LIVEBOARD_ID=your-liveboard-guid-here

# GUID of the worksheet/model backing the "Country Name" column -- used to
# fetch the RLS-scoped list of countries for the landing page dropdown.
TS_COUNTRY_WORKSHEET_ID=your-worksheet-guid-here

# GUID of the worksheet/model Spotter queries against on the "AI Analytics"
# page.
NEXT_PUBLIC_SPOTTER_WORKSHEET_ID=your-worksheet-guid-here

# Prospect-specific naming (see lib/embedBranding.ts). Changing these to
# reuse this app for a different prospect is a pure .env edit + rebuild --
# no code change needed.
NEXT_PUBLIC_BRAND_NAME=your-customer-name-here
NEXT_PUBLIC_SPOTTER_PERSONA_NAME=your-ai-persona-name-here
NEXT_PUBLIC_SPOTTER_CARD_LABEL=your-response-card-label-here

# Optional -- URL of a customer-hosted SVG sprite to replace ThoughtSpot's
# default icon set. Leave unset to keep the default icons.
NEXT_PUBLIC_ICON_SPRITE_URL=your-icon-sprite-svg-url-here
