# Copy to .env.local and fill in real values.

# Password to access the builder (internal team only).
BUILDER_PASSWORD=your-team-password-here

# Vercel Blob token — enables file uploads (screenshots, sample data CSVs).
# Get from Vercel Dashboard > Storage > Blob > your store > .env.local.
# Without this, file uploads are silently skipped; all other features work.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
